# ─────────────────────────────────────────────────────────────────────────────
# Barangay Hub v2 — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and MUST NOT be
# committed. No real credential value ever appears in this file.
#
# Phase 6 rules in force:
#   • The service-role key MUST NOT use the NEXT_PUBLIC_ prefix.
#   • The hosted Supabase project is NON-PRODUCTION until DEC-ENV-01 resolves.
#   • No real resident data or government ID files in any hosted environment.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
# local | test | preview | integration | production
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ─── Supabase — LOCAL (Supabase CLI, primary development environment) ────────
# `pnpm db:start` prints the API URL, anon key and service_role key for the
# local stack. Paste them below. These are local-only throwaway values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<set locally — printed by `pnpm db:start`>
SUPABASE_SERVICE_ROLE_KEY=<server-only — printed by `pnpm db:start`>

# ─── Supabase — HOSTED INTEGRATION ENVIRONMENT (Slice 0b) ────────────────────
# Non-production. Final role is an OPEN DECISION (DEC-ENV-01).
# Do not point local development at this project without an explicit reason.
#   NEXT_PUBLIC_SUPABASE_URL=https://weadxbwtupvjqaqploij.supabase.co
SUPABASE_PROJECT_REF=weadxbwtupvjqaqploij
SUPABASE_DB_PASSWORD=<secret-store-only — never committed, never printed>

# ─── Email (Slice 1 / EPIC-11) ───────────────────────────────────────────────
# console = log delivery intent only. Non-production environments MUST NOT send.
EMAIL_PROVIDER=console
RESEND_API_KEY=<secret-store-only>
EMAIL_FROM=
# Comma-separated allow-list; non-production only.
EMAIL_ALLOWLIST=

# ─── Background jobs (Slice 1 / EPIC-14) ─────────────────────────────────────
CRON_SECRET=<secret-store-only — min 16 chars>

# ─── Observability (Slice 1) ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Feature flags — platform defaults (Phase 6 §23.2) ───────────────────────
FLAG_ASSISTANCE_MODULE=false
FLAG_HOUSEHOLDS_MODULE=false
FLAG_FEEDBACK_MODULE=false
FLAG_SMS_CHANNEL=false
FLAG_ESIGNATURE=false
