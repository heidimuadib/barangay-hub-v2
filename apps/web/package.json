{
  "name": "@barangay-hub/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Barangay Hub v2 — Next.js application (server actions, repositories, services)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:local": "pnpm run e2e:local:desktop && pnpm run e2e:local:mobile",
    "e2e:local:desktop": "playwright test --project=chromium-desktop --workers=1",
    "e2e:local:mobile": "playwright test --project=chromium-mobile --workers=1",
    "check:bundle-secrets": "node scripts/check-bundle-secrets.mjs",
    "check:env-example": "node scripts/check-env-example.mjs",
    "check:boundaries": "node scripts/verify-boundaries.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "clsx": "^2.1.1",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "eslint-plugin-boundaries": "^5.0.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10"
  }
}
