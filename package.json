{
  "name": "barangay-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Barangay Hub v2 — multi-tenant civic services platform for Philippine barangays",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:reset:verified": "node scripts/db-reset-verified.mjs",
    "db:test": "supabase test db",
    "db:diff": "supabase db diff",
    "types:gen": "node scripts/gen-types.mjs",
    "types:check": "node scripts/gen-types.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:local": "pnpm run e2e:local:desktop && pnpm run e2e:local:mobile",
    "e2e:local:desktop": "playwright test --project=chromium-desktop --workers=1",
    "e2e:local:mobile": "playwright test --project=chromium-mobile --workers=1",
    "check:bundle-secrets": "node scripts/check-bundle-secrets.mjs",
    "check:env-example": "node scripts/check-env-example.mjs",
    "check:boundaries": "node scripts/verify-boundaries.mjs",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:env-example && pnpm run check:boundaries && pnpm run test",
    "verify:full": "pnpm run verify && pnpm run build && pnpm run check:bundle-secrets",
    "prepare": "node scripts/setup-husky.mjs",
    "verify:slice2": "pnpm run verify:full && pnpm run db:reset:verified && pnpm run db:test && pnpm run types:check"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "clsx": "^2.1.1",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.1.4",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "eslint-plugin-boundaries": "^5.0.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "supabase": "^2.23.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.4"
  }
}
