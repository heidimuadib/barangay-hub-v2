{
  "name": "barangay-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Barangay Hub v2 — multi-tenant civic services platform for Philippine barangays",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @barangay-hub/web run dev",
    "build": "pnpm --filter @barangay-hub/web run build",
    "start": "pnpm --filter @barangay-hub/web run start",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint . && pnpm -r --if-present run lint",
    "lint:fix": "eslint . --fix && pnpm -r --if-present run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "pnpm --filter @barangay-hub/supabase run db:start",
    "db:stop": "pnpm --filter @barangay-hub/supabase run db:stop",
    "db:status": "pnpm --filter @barangay-hub/supabase run db:status",
    "db:reset": "pnpm --filter @barangay-hub/supabase run db:reset",
    "db:reset:verified": "pnpm --filter @barangay-hub/supabase run db:reset:verified",
    "db:test": "pnpm --filter @barangay-hub/supabase run db:test",
    "db:diff": "pnpm --filter @barangay-hub/supabase run db:diff",
    "types:gen": "pnpm --filter @barangay-hub/supabase run types:gen",
    "types:check": "pnpm --filter @barangay-hub/supabase run types:check",
    "test": "pnpm --filter @barangay-hub/web run test",
    "test:watch": "pnpm --filter @barangay-hub/web run test:watch",
    "test:coverage": "pnpm --filter @barangay-hub/web run test:coverage",
    "e2e": "pnpm --filter @barangay-hub/web run e2e",
    "e2e:ui": "pnpm --filter @barangay-hub/web run e2e:ui",
    "e2e:install": "pnpm --filter @barangay-hub/web run e2e:install",
    "e2e:local": "pnpm --filter @barangay-hub/web run e2e:local",
    "e2e:local:desktop": "pnpm --filter @barangay-hub/web run e2e:local:desktop",
    "e2e:local:mobile": "pnpm --filter @barangay-hub/web run e2e:local:mobile",
    "check:bundle-secrets": "pnpm --filter @barangay-hub/web run check:bundle-secrets",
    "check:env-example": "pnpm --filter @barangay-hub/web run check:env-example",
    "check:boundaries": "pnpm --filter @barangay-hub/web run check:boundaries",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:env-example && pnpm run check:boundaries && pnpm run test",
    "verify:full": "pnpm run verify && pnpm run build && pnpm run check:bundle-secrets",
    "verify:slice2": "pnpm run verify:full && pnpm run db:reset:verified && pnpm run db:test && pnpm run types:check",
    "prepare": "node scripts/setup-husky.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.27.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.7"
  }
}
