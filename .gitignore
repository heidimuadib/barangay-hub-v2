next-env.d.ts

# production
build/
dist/

# environment — NEVER commit real credentials
.env
.env.*
!.env.example

# OAuth client-secret downloads. These land in the working directory with
# their default filenames and are real credentials — ignored so that a broad
# `git add` can never commit one. Keep them outside the repository.
client_secret*.json
*credentials*.json
service-account*.json

# supabase local state
backend/supabase/.temp/
backend/supabase/.branches/
backend/supabase/logs/

